@page "/posts/create"
@inject IPostService PostService
@inject NavigationManager navMgr

<h3>Create post</h3>
<AuthorizeView>
    <Authorized>
        <label>Title:</label>
        <input type="text" @bind="title"/>
        <label>Body:</label>
        <input type="text" @bind="body"/>
        @if (!string.IsNullOrEmpty(errorLabel))
        {
            <label style="color: red">@errorLabel</label>
        }
        <button @onclick="AddPostAsync">Create</button>
    </Authorized>
    <NotAuthorized>
        <p>You'll have to log in!</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter] public Task<AuthenticationState> State { get; set; } = null!;
    private string title = "";
    private string body = "";
    private string errorLabel = "";

    private async Task AddPostAsync()
    {
        errorLabel = "";
        try
        {
            AuthenticationState authenticationState = await State;
            int userId = int.Parse(authenticationState.User.Claims.Single(c => c.Type == "Id").Value);
            PostDto created = await PostService.AddPostAsync(new CreatePostDto
            {
                Title = title,
                Body = body,
                UserId = userId
            });
            navMgr.NavigateTo($"/posts/{created.Id}");
        }
        catch (Exception e)
        {
            errorLabel = $"Error: {e.Message}";
        }
    }
}
